# Install only after TLS certificates exist. Node listens exclusively on loopback.
server {
    listen 80;
    listen [::]:80;
    server_name avtofakt.by www.avtofakt.by;
    location ^~ /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 301 https://avtofakt.by$request_uri; }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.avtofakt.by;
    ssl_certificate /etc/letsencrypt/live/avtofakt.by/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/avtofakt.by/privkey.pem;
    return 301 https://avtofakt.by$request_uri;
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name avtofakt.by;
    ssl_certificate /etc/letsencrypt/live/avtofakt.by/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/avtofakt.by/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 32k;
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;
    # Enable only when nginx has the Brotli module:
    # brotli on;
    # brotli_comp_level 5;
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Connection "";
        proxy_read_timeout 60s;
    }
}
